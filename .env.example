# ---- Core ----
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Set DB_ENGINE=postgres to use PostgreSQL (recommended for dev via docker-compose and required in production).
# Set DB_ENGINE=sqlite for a zero-dependency local fallback (NOT for production).
DB_ENGINE=postgres
POSTGRES_DB=tahweel
POSTGRES_USER=tahweel
POSTGRES_PASSWORD=tahweel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Storage ----
# STORAGE_BACKEND=local uses Django FileSystemStorage under MEDIA_ROOT (default for dev).
# STORAGE_BACKEND=r2 uses Cloudflare R2 via django-storages S3Boto4Storage (use in production).
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tahweel-media
R2_PUBLIC_DOMAIN=

# ---- JWT ----
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
